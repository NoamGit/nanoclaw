# Copy to ~/.config/nanoclaw/ops.env — sourced by baz / backup / cleanup (all keys optional)
# NANOCLAW_HOME=/home/nanoclaw/nanoclaw-v2      # default: parent of ops/
# BACKUP_DIR=$HOME/backups
EXTERNAL_BACKUP_DIR="/path/to/external/drive/nanoclaw-backups"   # empty/unset = no off-box copy
# ALERT_ENV=$HOME/.config/nanoclaw/alert.env
# Disk watchdog tuning (defaults shown)
# WARN_PCT=90            # start emergency prune at this % used
# CRIT_PCT=95            # "manual action needed" alert if still above after pruning
# ALERT_COOLDOWN_H=6     # at most one Telegram alert per this many hours
# ALERT_MIN_FREED_MB=1024  # non-critical alerts only if the prune freed at least this much
