# Copy to ~/.config/nanoclaw/ops.env — sourced by baz / backup / cleanup (all keys optional)
# NANOCLAW_HOME=/home/nanoclaw/nanoclaw-v2      # default: parent of ops/
# BACKUP_DIR=$HOME/backups
EXTERNAL_BACKUP_DIR="/path/to/external/drive/nanoclaw-backups"   # empty/unset = no off-box copy
# ALERT_ENV=$HOME/.config/nanoclaw/alert.env
